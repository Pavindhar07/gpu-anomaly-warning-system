# ---- Backend (export these, or put them in your process manager) ----
# auto   = use a local CUDA library if built, else GPU_BACKEND_URL if set, else CPU-only
# local  = require backend/cuda/build/libanomaly.so    remote = forward GPU work to GPU_BACKEND_URL    off = CPU only
GPU_MODE=auto
CUDA_LIB_PATH=backend/cuda/build/libanomaly.so
GPU_BACKEND_URL=
GPU_BACKEND_TOKEN=
# Set on the machine that HAS the GPU to protect POST /api/gpu/analyze
GPU_API_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=100
MAX_ROWS=5000000
MAX_SYNTHETIC_ROWS=5000000
MAX_BENCHMARK_SIZE=5000000
# ---- Frontend: see frontend/.env.example (VITE_API_URL) ----
